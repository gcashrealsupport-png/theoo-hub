    lab.Text = name
    lab.TextColor3 = Color3.fromRGB(180,180,190)
    lab.TextSize = 8
    lab.TextXAlignment = Enum.TextXAlignment.Left
    local val = Instance.new("TextLabel", wrap)
    val.Size = UDim2.fromOffset(26,12)
    val.Position = UDim2.new(1,-30,0,0)
    val.BackgroundTransparency = 1
    val.Text = tostring(default)
    val.TextColor3 = Color3.fromRGB(200,200,255)
    val.TextSize = 8
    local track = Instance.new("Frame", wrap)
    track.Size = UDim2.new(1,-8,0,4)
    track.Position = UDim2.fromOffset(4,16)
    track.BackgroundColor3 = Color3.fromRGB(45,45,55)
    Instance.new("UICorner", track).CornerRadius = UDim.new(1,0)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((default-min)/math.max(max-min,1),0,1,0)
    fill.BackgroundColor3 = Color3.fromRGB(100,120,220)
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)
    local drag = false
    local function setA(a)
        a = math.clamp(a,0,1)
        local v = math.floor(min + (max-min)*a)
        fill.Size = UDim2.new((v-min)/math.max(max-min,1),0,1,0)
        val.Text = tostring(v)
        cb(v)
    end
    track.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true; setA((i.Position.X-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1)) end end)
    UserInputService.InputChanged:Connect(function(i) if drag and i.UserInputType == Enum.UserInputType.MouseMovement then setA((i.Position.X-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1)) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
end

