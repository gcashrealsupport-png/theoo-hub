-- 10. MAIN LOOP
--==================================================
RunService.RenderStepped:Connect(function()
    Camera = Workspace.CurrentCamera
    
    -- TP Cam
    if Config.TPCam and Config.TPCamTarget and Config.TPCamTarget.Character then
        local th = Config.TPCamTarget.Character:FindFirstChild("Head")
        if th then
            Camera.CameraType = Enum.CameraType.Scriptable
            Camera.CFrame = CFrame.lookAt(th.Position + Vector3.new(0, 3, -8), th.Position)
        end
    end

    -- Target Selection
    local targetP, targetPart = FindTarget()
    
    if Config.SilentAim then
        SA.targetPart = targetPart
    end

    -- Aimbot / Aim Assist
    if targetPart and (Config.Aimbot or Config.AimAssist) then
        local desired = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
        local alpha = Config.Aimbot and (Config.SmoothAim/100) or (Config.SmoothAssist/100)
        if alpha > 0 then
            Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
        end
    end

    -- WalkSpeed & Noclip
    if LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed ~= Config.WalkSpeed then hum.WalkSpeed = Config.WalkSpeed end
        if Config.Noclip then
            for _, v in ipairs(LP.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
        end
    end

    -- Combat (Rapid Fire, Auto Reload, No Recoil)
    if LP.Character then
        local tool = LP.Character:FindFirstChildOfClass("Tool")
        if tool then
            if Config.RapidFire then
                local nv = tool:FindFirstChild("RateOfFire") or tool:FindFirstChild("FireRate")
                if nv then nv.Value = 0.1 end
            end
            if Config.AutoReload then
                for _, v in ipairs(tool:GetDescendants()) do
                    if v:IsA("NumberValue") and v.Name:lower():find("ammo") then v.Value = 9999 end
                end
            end
            if Config.NoRecoil then
                for _, v in ipairs(tool:GetDescendants()) do
                    if v:IsA("NumberValue") and (v.Name:lower():find("recoil") or v.Name:lower():find("spread")) then v.Value = 0 end
                end
            end
