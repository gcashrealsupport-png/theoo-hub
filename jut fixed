local ESPFolder = Instance.new("Folder", Workspace)
ESPFolder.Name = "JutHubESP"

local function UpdateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local char = p.Character
            if Config.ESP and char and not IsSameTeam(p) then
                if not ESPData[p] then
                    local h = Instance.new("Highlight", ESPFolder)
                    h.Adornee = char
                    h.FillTransparency = 0.5
                    local n = Instance.new("BillboardGui", ESPFolder)
                    n.Adornee = char:FindFirstChild("Head")
                    n.Size = UDim2.fromOffset(80,15)
                    n.AlwaysOnTop = true
                    local t = Instance.new("TextLabel", n)
                    t.Size = UDim2.fromScale(1,1)
                    t.BackgroundTransparency = 1
                    t.Text = p.DisplayName
                    t.TextColor3 = Color3.new(1,1,1)
                    t.TextSize = 9
                    ESPData[p] = { h = h, n = n }
                else
                    ESPData[p].h.Adornee = char
                    ESPData[p].n.Adornee = char:FindFirstChild("Head")
                end
            elseif ESPData[p] then
                ESPData[p].h:Destroy()
                ESPData[p].n:Destroy()
                ESPData[p] = nil
            end
        end
    end
end

