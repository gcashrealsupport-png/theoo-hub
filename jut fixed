local function CreateSlider(parent, name, min, max, default, cb)
    local wrap = Instance.new("Frame", parent)
    wrap.Size = UDim2.new(1,-2,0,28)
    wrap.BackgroundColor3 = Color3.fromRGB(26,26,35)
    Instance.new("UICorner", wrap).CornerRadius = UDim.new(0,4)
