local Config = {
    SilentAim = false, Aimbot = false, AimAssist = false, ESP = false, Wall = false, HideFOV = false,
    TeamCheck = true, TPCam = false, TPCamTarget = nil,
    WalkSpeed = 16, Noclip = false, InfJump = false, RapidFire = false, AutoReload = false, NoRecoil = false,
    TargetPart = "Head", FovRadius = 120, SmoothAim = 25, SmoothAssist = 50,
    SA_Names = {"hit", "bullet", "projectile", "hitscan", "shoot", "fire", "attack"}
}
local SA = { targetPart = nil, namecallOld = nil, hookActive = false }
local ESPData = {}

local function IsSameTeam(plr)
    if not Config.TeamCheck then return false end
    if not plr or plr == LP then return true end
    if LP.Team and plr.Team then return LP.Team == plr.Team end
    if LP.TeamColor and plr.TeamColor then return LP.TeamColor == plr.TeamColor end
    return false
end

local function GetPart(char)
    if not char then return nil end
    if Config.TargetPart == "Head" then return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") end
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end

local function Alive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function FindTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil, nil end
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local bestP, bestPart, bestScore = nil, nil, math.huge
    local fovSq = Config.FovRadius * Config.FovRadius
    for _, t in ipairs(Players:GetPlayers()) do
        if t ~= LP and not IsSameTeam(t) and t.Character and Alive(t.Character) then
            local part = GetPart(t.Character)
            if part then
                local scr, on = cam:WorldToViewportPoint(part.Position)
                if on and scr.Z > 0 then
                    local dx, dy = scr.X - center.X, scr.Y - center.Y
                    local dSq = dx*dx + dy*dy
                    if dSq <= fovSq and dSq < bestScore then
                        bestScore = dSq; bestP = t; bestPart = part
                    end
                end
            end
        end
    end
    return bestP, bestPart
end

