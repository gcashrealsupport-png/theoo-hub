local function ApplyRapidFire()
    if not RapidFire then return end
    local char = LP.Character
    if not char then return end
    local function Apply(tool)
        tool:SetAttribute("RateOfFire", RapidRate)
        tool:SetAttribute("rateOfFire", RapidRate)
        local nv = tool:FindFirstChild("RateOfFire") or tool:FindFirstChild("FireRate")
        if nv and nv:IsA("NumberValue") then nv.Value = RapidRate end
    end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then Apply(tool) end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _, tool in ipairs(bp:GetChildren()) do if tool:IsA("Tool") then Apply(tool) end end end
end

local function ApplyAutoReload()
    if not AutoReload then return end
    local char = LP.Character
    if not char then return end
    local function Apply(tool)
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") and v.Name:lower():find("ammo") then v.Value = 9999 end
        end
    end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then Apply(tool) end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _, tool in ipairs(bp:GetChildren()) do if tool:IsA("Tool") then Apply(tool) end end end
end

local function ApplyNoRecoil()
    if not NoRecoil then return end
    local char = LP.Character
    if not char then return end
    local function Apply(tool)
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") and (v.Name:lower():find("recoil") or v.Name:lower():find("spread")) then
                v.Value = 0
            end
        end
    end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then Apply(tool) end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _, tool in ipairs(bp:GetChildren()) do if tool:IsA("Tool") then Apply(tool) end end end
end

local function ApplyNoclip()
    if not Noclip then return end
    local char = LP.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end

local function ApplyWalkSpeed()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.WalkSpeed ~= WalkSpeed then
        hum.WalkSpeed = WalkSpeed
    end
end

