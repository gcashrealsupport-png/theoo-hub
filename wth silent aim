-- CHARACTER HELPERS
--==================================================

local function Alive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function GetPart(char)
    if not char then return nil end
    if TargetPart == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end

-- ISANG Team Check — gumagana sa Silent Aim, Aimbot, at ESP
local function SameTeam(p)
    if not TeamCheck then return false end
    if not p or p == LP then return false end
    if LP.Team and p.Team then
        return LP.Team == p.Team
    end
    return false
end

local function Visible(char, part)
    if not Wall then return true end
    if not Camera then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {}
    if LP.Character then table.insert(ignore, LP.Character) end
    params.FilterDescendantsInstances = ignore
    local origin = Camera.CFrame.Position
    local direction = part.Position - origin
    local result = workspace:Raycast(origin, direction, params)
    return not result or result.Instance:IsDescendantOf(char)
end

local function DistanceFromCenter(part)
    local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen or screen.Z <= 0 then return math.huge end
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    return (Vector2.new(screen.X, screen.Y) - center).Magnitude
end

local function Valid(p)
    if not p or p == LP then return false end
    if Excluded[p] == true then return false end
    if SameTeam(p) then return false end
    if not p.Character or not Alive(p.Character) then return false end
    local part = GetPart(p.Character)
    if not part then return false end
    if DistanceFromCenter(part) > FOV then return false end
    if not Visible(p.Character, part) then return false end
    return true
end

local function Closest()
    local best, bestDist = nil, FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and Excluded[p] ~= true and not SameTeam(p) and p.Character and Alive(p.Character) then
            local part = GetPart(p.Character)
            if part then
                local d = DistanceFromCenter(part)
                if d <= bestDist and Visible(p.Character, part) then
                    bestDist = d
                    best = p
                end
            end
        end
    end
    return best
end

--==================================================
-- SILENT AIM (theoo hub style)
--==================================================

local function SACharacter(target)
    if not target then return nil end
    if typeof(target) == "Instance" then
        if target:IsA("Player") then
            return target.Character
        elseif target:IsA("Model") then
            return target
        end
    end
    return nil
end

local function SAAlive(target)
    local char = SACharacter(target)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    return hum ~= nil and hum.Health > 0 and root ~= nil
end

local function SAPart(target)
    local char = SACharacter(target)
    if not char then return nil end
    return char:FindFirstChild(TargetPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("HumanoidRootPart")
end

local function SAEnemy(player)
    if not player or player == LP then return false end
    if SameTeam(player) then return false end
    return true
end

local function SAVisible(character, part)
    if not Wall then return true end
    if not character or not part then return false end
    local camera = workspace.CurrentCamera
    if not camera then return false end
    local origin = camera.CFrame.Position
    local direction = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character, character }
    params.IgnoreWater = true
    return workspace:Raycast(origin, direction, params) == nil
end

local function SAFindTarget()
    if not SilentAim then return nil, nil end
    local camera = workspace.CurrentCamera
    if not camera then return nil, nil end
    local center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    local bestPlayer, bestPart = nil, nil
    local bestScore = math.huge
    local fovSq = FOV * FOV
    for _, target in ipairs(Players:GetPlayers()) do
        if SAEnemy(target) and SAAlive(target) then
            local character = target.Character
            local part = SAPart(target)
            if character and part then
                if SAVisible(character, part) then
                    local screen, onScreen = camera:WorldToViewportPoint(part.Position)
                    if onScreen and screen.Z > 0 then
                        local dx = screen.X - center.X
                        local dy = screen.Y - center.Y
                        local distSq = dx*dx + dy*dy
                        if distSq <= fovSq and distSq < bestScore then
                            bestScore = distSq
                            bestPlayer = target
                            bestPart = part
                        end
                    end
                end
            end
        end
    end
    return bestPlayer, bestPart
end

local function SAUpdateTarget()
    if not SilentAim then
        SA.targetPlayer = nil
        SA.targetPart = nil
        return
    end
    local p, part = SAFindTarget()
    SA.targetPlayer = p
    SA.targetPart = part
end

local function SARewriteValue(value, keyHint, targetPos, hitPart)
    local kind = typeof(value)
    keyHint = type(keyHint) == "string" and string.lower(keyHint) or ""
    if kind == "Vector3" then
        if keyHint == "direction" or keyHint == "lookvector" or keyHint == "dir" then
            local delta = targetPos - value
            return delta.Magnitude > 0 and delta.Unit or value
        elseif keyHint == "hitposition" or keyHint == "hitpos" or keyHint == "endposition" or keyHint == "endpos" then
            return targetPos
        end
        return value
    elseif kind == "CFrame" then
        if keyHint == "direction" or keyHint == "lookvector" then
            return CFrame.lookAt(value.Position, targetPos)
        end
        return value
    elseif kind == "Ray" then
        local delta = targetPos - value.Origin
        return delta.Magnitude > 0 and Ray.new(value.Origin, delta.Unit * 1000) or value
    elseif kind == "table" then
        local out = {}
        for key, child in pairs(value) do
            local hint = type(key) == "string" and string.lower(key) or ""
            out[key] = SARewriteValue(child, hint, targetPos, hitPart)
        end
        if not out.hitPosition then out.hitPosition = targetPos end
        if not out.hitPart then out.hitPart = hitPart end
        return out
    end
    return value
end

local function SARewriteArgs(args, targetPos, hitPart)
    local newArgs = table.clone(args)
    for i, value in ipairs(newArgs) do
        local kind = typeof(value)
        if kind == "table" then
            newArgs[i] = SARewriteValue(value, nil, targetPos, hitPart)
        elseif kind == "Vector3" then
            local delta = targetPos - value
            if delta.Magnitude > 0 then
                newArgs[i] = delta.Unit * math.max(delta.Magnitude, 1)
            end
        elseif kind == "CFrame" then
            newArgs[i] = CFrame.lookAt(value.Position, targetPos)
        elseif kind == "Ray" then
            newArgs[i] = SARewriteValue(value, nil, targetPos, hitPart)
        end
    end
    return newArgs
end

local function SARemoteMatches(remote)
    if typeof(remote) ~= "Instance" then return false end
    if not (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") or remote:IsA("UnreliableRemoteEvent")) then
        return false
    end
    local name = string.lower(remote.Name)
    local wanted = { "hit", "bullet", "projectile", "hitscan", "shoot", "attack", "damage" }
    for _, w in ipairs(wanted) do
        if string.find(name, w, 1, true) then return true end
    end
    return false
end

function SARestoreHooks()
    if SA.namecallOld and hookmetamethod then
        pcall(function()
            hookmetamethod(game, "__namecall", SA.namecallOld)
        end)
        SA.namecallOld = nil
    end
    SA.hookActive = false
end

function SAInstallHooks()
    if SA.hookActive then return end
    if type(hookmetamethod) ~= "function"
        or type(newcclosure) ~= "function"
        or type(getnamecallmethod) ~= "function"
        or type(checkcaller) ~= "function" then
        warn("[Alkedion] Silent Aim needs metamethod hook support.")
        return
    end
    SA.namecallOld = hookmetamethod(game, "__namecall", newcclosure(function(...)
        local args = {...}
        if not SilentAim then
            return SA.namecallOld(...)
        end
        if checkcaller() then
            return SA.namecallOld(...)
        end
        local method = getnamecallmethod()
        local isRaycast = method == "Raycast"
        local isFire = method == "FireServer"
        local isInvoke = method == "InvokeServer"
        if not isRaycast and not isFire and not isInvoke then
            return SA.namecallOld(...)
        end
        if (isFire or isInvoke) and not SARemoteMatches(args[1]) then
            return SA.namecallOld(...)
        end
        local hitPart = SA.targetPart
        if not hitPart or not hitPart.Parent then
            return SA.namecallOld(...)
        end
        local targetPos = hitPart.Position
        if isRaycast then
            local origin = args[2]
            local direction = args[3]
            if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then
                return SA.namecallOld(...)
            end
            local delta = targetPos - origin
            if delta.Magnitude > 0 then
                args[3] = delta.Unit * direction.Magnitude
            end
            return SA.namecallOld(unpack(args))
        end
        local rewritten = SARewriteArgs(args, targetPos, hitPart)
        return SA.namecallOld(unpack(rewritten))
    end))
    SA.hookActive = true
    print("[Alkedion] Silent Aim hooks installed")
end

