--==================================================
-- CHARACTER HELPERS
--==================================================

local function Alive(char)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum and hum.Health > 0
end

local function GetPart(char)
	if not char then return nil end
	if TargetPart == "Head" then
		return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	end
	return char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- TEAM CHECK
--==================================================

local function SameTeam(p)
	if not TeamCheck then return false end
	if not p or p == LP then return false end
	local myTeam = LP.Team
	local otherTeam = p.Team
	if myTeam and otherTeam then
		return myTeam == otherTeam
	end
	return false
end

--==================================================
-- WALL CHECK
--==================================================

local function Visible(char,part)
	if not Wall then return true end
	if not Camera then return false end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude

	local ignore = {}
	if LP.Character then
		table.insert(ignore, LP.Character)
	end
	params.FilterDescendantsInstances = ignore

	local origin = Camera.CFrame.Position
	local direction = part.Position-origin

	local result = workspace:Raycast(origin, direction, params)

	return not result or result.Instance:IsDescendantOf(char)
end

--==================================================
-- TARGETING
--==================================================

local function DistanceFromCenter(part)
	local screen,onScreen = Camera:WorldToViewportPoint(part.Position)
	if not onScreen or screen.Z <= 0 then return math.huge end

	local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
	return (Vector2.new(screen.X,screen.Y)-center).Magnitude
end

local function Valid(p)
	if not p or p == LP then return false end
	if Excluded[p] == true then return false end
	if SameTeam(p) then return false end
	if not p.Character then return false end
	if not Alive(p.Character) then return false end

	local part = GetPart(p.Character)
	if not part then return false end
	if DistanceFromCenter(part) > FOV then return false end
	if not Visible(p.Character,part) then return false end

	return true
end

local function Closest()
	local best = nil
	local bestDist = FOV
	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= LP and Excluded[p] ~= true and not SameTeam(p)
			and p.Character and Alive(p.Character) then
			local part = GetPart(p.Character)
			if part then
				local d = DistanceFromCenter(part)
				if d <= bestDist and Visible(p.Character,part) then
					bestDist = d
					best = p
				end
			end
		end
	end
	return best
end

--==================================================
-- ESP
--==================================================

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "AlkedionESP"
ESPFolder.Parent = workspace

local ESPData = {}

local function RemoveESP(p)
	local d = ESPData[p]
	if d then
		if d.Highlight then d.Highlight:Destroy() end
		if d.NameGui then d.NameGui:Destroy() end
		ESPData[p] = nil
	end
end

local function MakeESP(p)
	if p == LP then return end
	if Excluded[p] == true then RemoveESP(p) return end
	if not p.Character then return end
	RemoveESP(p)

	local char = p.Character
	local h = Instance.new("Highlight")
	h.Adornee = char
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.FillTransparency = .55
	h.OutlineTransparency = 0
	h.Enabled = ESP
	h.Parent = ESPFolder

	local head = char:FindFirstChild("Head")
	local nameGui = Instance.new("BillboardGui")
	nameGui.Adornee = head
	nameGui.Size = UDim2.fromOffset(130,24)
	nameGui.StudsOffset = Vector3.new(0,3,0)
	nameGui.AlwaysOnTop = true
	nameGui.Enabled = ESP
	nameGui.Parent = ESPFolder

	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1,1)
	text.BackgroundTransparency = 1
	text.Text = p.DisplayName
	text.TextColor3 = Color3.new(1,1,1)
	text.TextStrokeTransparency = .2
	text.TextSize = 11
	text.Font = Enum.Font.GothamBold
	text.Parent = nameGui

	ESPData[p] = { Highlight = h, NameGui = nameGui }
end

local function UpdateESP()
	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			if Excluded[p] == true then
				if ESPData[p] then RemoveESP(p) end
			elseif ESP then
				if not ESPData[p] then MakeESP(p) end
				local d = ESPData[p]
				if d and p.Character then
					d.Highlight.Adornee = p.Character
					d.Highlight.Enabled = true
					local head = p.Character:FindFirstChild("Head")
					if head then d.NameGui.Adornee = head end
					d.NameGui.Enabled = true
				end
			elseif ESPData[p] then
				ESPData[p].Highlight.Enabled = false
				ESPData[p].NameGui.Enabled = false
			end
		end
	end
end

--==================================================
-- HITBOX EXPANDER (VISIBLE)
--==================================================

local HitboxData = {}

local function RemoveHitbox(p)
	local d = HitboxData[p]
	if d then
		if d.Box then d.Box:Destroy() end
		HitboxData[p] = nil
	end
end

local function MakeHitbox(p)
	if p == LP then return end
	if Excluded[p] == true then RemoveHitbox(p) return end
	if not p.Character then return end
	RemoveHitbox(p)

	local char = p.Character
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local box = Instance.new("SelectionBox")
	box.Name = "AlkedionHB"
	box.Adornee = hrp
	box.LineThickness = 0.05
	box.Color3 = Color3.fromRGB(255, 50, 50)
	box.SurfaceTransparency = 1
	box.Transparency = 0
	box.Parent = HBFrame

	for _,part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			part.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
			part.Transparency = 0.7
			part.CanCollide = false
		end
	end

	HitboxData[p] = {
		Box = box,
		Char = char,
	}
end

local function UpdateHitbox()
	if not Hitbox then
		for p, _ in pairs(HitboxData) do
			RemoveHitbox(p)
		end
		return
	end

	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= LP and Excluded[p] ~= true and p.Character then
			if not HitboxData[p] then
				MakeHitbox(p)
			else
				local d = HitboxData[p]
				if d.Char == p.Character then
					for _,part in ipairs(p.Character:GetChildren()) do
						if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
							part.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
							part.Transparency = 0.7
							part.CanCollide = false
						end
					end
					if d.Box and d.Box.Adornee ~= p.Character:FindFirstChild("HumanoidRootPart") then
						d.Box.Adornee = p.Character:FindFirstChild("HumanoidRootPart")
					end
				else
					RemoveHitbox(p)
					MakeHitbox(p)
				end
			end
		end
	end

	for p, d in pairs(HitboxData) do
		if Excluded[p] == true or not p.Character or p.Character ~= d.Char then
			RemoveHitbox(p)
		end
	end
end

