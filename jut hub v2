RunService:BindToRenderStep(
	"ALKEDION_AIM",
	Enum.RenderPriority.Camera.Value + 10,
	function()
		Camera = workspace.CurrentCamera
		if not Camera then return end

		UpdateFOV()
		UpdateESP()
		UpdateHitbox()
		ApplyGodMode()
		ApplyRapidFire()
		ApplyAutoReload()
		ApplyNoRecoil()

		if not Aim then
			Target = nil
			TargetText.Text = "Target: None"
			return
		end

		if Lock then
			if not Valid(Target) then
				Target = Closest()
			end
		else
			Target = Closest()
		end

		if Target and Valid(Target) then
			local part = GetPart(Target.Character)
			if part then
				local desired = CFrame.lookAt(Camera.CFrame.Position, part.Position)
				local alpha = math.clamp(Smooth/100, .01, 1)
				Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
				TargetText.Text = "Target: " .. Target.DisplayName
			end
		else
			Target = nil
			TargetText.Text = "Target: None"
		end
	end
)

