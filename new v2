    Excluded[p] = nil
    if Target == p then Target = nil end
end)

--==================================================
-- APPLY LOOPS
--==================================================

local function ApplyRapidFire()
    if not RapidFire then return end
    local char = LP.Character
    if not char then return end
    local function Apply(tool)
        tool:SetAttribute("RateOfFire", RapidRate)
        tool:SetAttribute("rateOfFire", RapidRate)
        local nv = tool:FindFirstChild("RateOfFire") or tool:FindFirstChild("FireRate")
        if nv and nv:IsA("NumberValue") then nv.Value = RapidRate end
    end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then Apply(tool) end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _, tool in ipairs(bp:GetChildren()) do if tool:IsA("Tool") then Apply(tool) end end end
end

local function ApplyAutoReload()
    if not AutoReload then return end
    local char = LP.Character
    if not char then return end
    local function Apply(tool)
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") and v.Name:lower():find("ammo") then v.Value = 9999 end
        end
    end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then Apply(tool) end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _, tool in ipairs(bp:GetChildren()) do if tool:IsA("Tool") then Apply(tool) end end end
end

local function ApplyNoRecoil()
    if not NoRecoil then return end
    local char = LP.Character
    if not char then return end
    local function Apply(tool)
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") and (v.Name:lower():find("recoil") or v.Name:lower():find("spread")) then
                v.Value = 0
            end
        end
    end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then Apply(tool) end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _, tool in ipairs(bp:GetChildren()) do if tool:IsA("Tool") then Apply(tool) end end end
end

local function ApplyNoclip()
    if not Noclip then return end
    local char = LP.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end

local function ApplyWalkSpeed()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.WalkSpeed ~= WalkSpeed then
        hum.WalkSpeed = WalkSpeed
    end
end

--==================================================
-- MAIN LOOP
--==================================================

RunService:BindToRenderStep(
    "ALKEDION_AIM",
    Enum.RenderPriority.Camera.Value + 10,
    function()
        Camera = workspace.CurrentCamera
        if not Camera then return end

        UpdateFOV()
        UpdateESP()
        ApplyRapidFire()
        ApplyAutoReload()
        ApplyNoRecoil()
        ApplyNoclip()
        ApplyWalkSpeed()

        if AimAssist and not Aimbot then
            local t = Closest()
            if t and Valid(t) then
                local part = GetPart(t.Character)
                if part then
                    local desired = CFrame.lookAt(Camera.CFrame.Position, part.Position)
                    local alpha = math.clamp(SmoothAssist/100, .01, 1)
                    Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
                    Target = t
                end
            else
                Target = nil
            end
        end

        if Aimbot then
            if Lock then
                if not Valid(Target) then Target = Closest() end
            else
                Target = Closest()
            end

            if Target and Valid(Target) then
                local part = GetPart(Target.Character)
                if part then
                    local desired = CFrame.lookAt(Camera.CFrame.Position, part.Position)
                    local alpha = math.clamp(SmoothAim/100, .01, 1)
                    Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
                end
            else
                Target = nil
            end
        end

        if not AimAssist and not Aimbot then
            Target = nil
        end
    end
)

