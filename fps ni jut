-- FPS / PING DISPLAY
--==================================================

local frames, lastTime = 0, tick()
RunService.RenderStepped:Connect(function()
    frames = frames + 1
    if tick() - lastTime >= 1 then
        local fps = frames
        frames = 0
        lastTime = tick()
        local ping = "?"
        pcall(function()
            ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        Info.Text = "FPS: " .. fps .. "  |  Ping: " .. ping
    end
end)

