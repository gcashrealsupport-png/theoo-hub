local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "AlkedionESP"
ESPFolder.Parent = workspace
local ESPData = {}

local function RemoveESP(p)
    local d = ESPData[p]
    if d then
        if d.Highlight then d.Highlight:Destroy() end
        if d.NameGui then d.NameGui:Destroy() end
        ESPData[p] = nil
    end
end

local function MakeESP(p)
    if p == LP or Excluded[p] == true or not p.Character then return end
    RemoveESP(p)
    local char = p.Character
    local h = Instance.new("Highlight")
    h.Adornee = char
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.FillTransparency = .55
    h.OutlineTransparency = 0
    h.Enabled = ESP
    h.Parent = ESPFolder
    local head = char:FindFirstChild("Head")
    local nameGui = Instance.new("BillboardGui")
    nameGui.Adornee = head
    nameGui.Size = UDim2.fromOffset(120,22)
    nameGui.StudsOffset = Vector3.new(0,3,0)
    nameGui.AlwaysOnTop = true
    nameGui.Enabled = ESP
    nameGui.Parent = ESPFolder
    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1,1)
    text.BackgroundTransparency = 1
    text.Text = p.DisplayName
    text.TextColor3 = Color3.new(1,1,1)
    text.TextStrokeTransparency = .2
    text.TextSize = 10
    text.Font = Enum.Font.GothamBold
    text.Parent = nameGui
    ESPData[p] = { Highlight = h, NameGui = nameGui }
end

local function UpdateESP()
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            if Excluded[p] == true then
                if ESPData[p] then RemoveESP(p) end
            elseif ESP then
                if not ESPData[p] then MakeESP(p) end
                local d = ESPData[p]
                if d and p.Character then
                    d.Highlight.Adornee = p.Character
                    d.Highlight.Enabled = true
                    local head = p.Character:FindFirstChild("Head")
                    if head then d.NameGui.Adornee = head end
                    d.NameGui.Enabled = true
                end
            elseif ESPData[p] then
                ESPData[p].Highlight.Enabled = false
                ESPData[p].NameGui.Enabled = false
            end
        end
    end
end

--==================================================
-- HITBOX (real Part + BoxHandleAdornment)
--==================================================

local HitboxData = {}

local function RemoveHitbox(p)
    local d = HitboxData[p]
    if d then
        if d.Part then d.Part:Destroy() end
        if d.Adorn then d.Adorn:Destroy() end
        HitboxData[p] = nil
    end
end

local function MakeHitbox(p)
    if p == LP or Excluded[p] == true or not p.Character then return end
    RemoveHitbox(p)
    local char = p.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local folder = workspace:FindFirstChild("AlkedionHitbox")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "AlkedionHitbox"
        folder.Parent = workspace
    end

    local part = Instance.new("Part")
    part.Name = "AlkedionHB"
    part.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
    part.Transparency = 1
    part.CanCollide = false
    part.CanQuery = true
    part.Anchored = true
    part.Massless = true
    part.Parent = folder

    local adorn = Instance.new("BoxHandleAdornment")
    adorn.Name = "AlkedionHBAdorn"
    adorn.Adornee = part
    adorn.AlwaysOnTop = true
    adorn.ZIndex = 10
    adorn.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
    adorn.Transparency = 0.3
    adorn.Color3 = Color3.fromRGB(255, 50, 50)
    adorn.Parent = part

    HitboxData[p] = {
        Part = part,
        Adorn = adorn,
        Char = char,
    }
end

local function UpdateHitbox()
    if not Hitbox then
        for p, _ in pairs(HitboxData) do RemoveHitbox(p) end
        return
    end

    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP and Excluded[p] ~= true and p.Character then
            local d = HitboxData[p]
            if not d or d.Char ~= p.Character then
                RemoveHitbox(p)
                MakeHitbox(p)
            else
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp and d.Part then
                    d.Part.CFrame = hrp.CFrame
                    d.Part.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                    d.Adorn.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                end
            end
        end
    end

    for p, d in pairs(HitboxData) do
        if Excluded[p] == true or not p.Character or p.Character ~= d.Char then
            RemoveHitbox(p)
        end
    end
end

