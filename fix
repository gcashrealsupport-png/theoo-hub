--==================================================

local function ApplyGodMode()
    if not GodMode then return end
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.MaxHealth = math.huge
        hum.Health = math.huge
        hum.BreakJointsOnDeath = false
        hum.RequiresNeck = false
    end
    for _,v in ipairs(char:GetDescendants()) do
        if v:IsA("BoolValue") and (v.Name:lower():find("god") or v.Name:lower():find("invincible")) then
            v.Value = true
        end
        if v:IsA("ForceField") then v:Destroy() end
    end
end

local function ApplyRapidFire()
    if not RapidFire then return end
    local char = LP.Character
    if not char then return end
    local function Apply(tool)
        tool:SetAttribute("RateOfFire", RapidRate)
        tool:SetAttribute("rateOfFire", RapidRate)
        local nv = tool:FindFirstChild("RateOfFire") or tool:FindFirstChild("FireRate")
        if nv and nv:IsA("NumberValue") then nv.Value = RapidRate end
    end
    for _,tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then Apply(tool) end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _,tool in ipairs(bp:GetChildren()) do if tool:IsA("Tool") then Apply(tool) end end end
end

local function ApplyAutoReload()
    if not AutoReload then return end
    local char = LP.Character
    if not char then return end
    local function Apply(tool)
        for _,v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") and v.Name:lower():find("ammo") then v.Value = 9999 end
        end
    end
    for _,tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then Apply(tool) end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _,tool in ipairs(bp:GetChildren()) do if tool:IsA("Tool") then Apply(tool) end end end
end

local function ApplyNoRecoil()
    if not NoRecoil then return end
    local char = LP.Character
    if not char then return end
    local function Apply(tool)
        for _,v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") and (v.Name:lower():find("recoil") or v.Name:lower():find("spread")) then
                v.Value = 0
            end
        end
    end
    for _,tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then Apply(tool) end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _,tool in ipairs(bp:GetChildren()) do if tool:IsA("Tool") then Apply(tool) end end end
end

--==================================================
-- MAIN LOOP
--==================================================

RunService:BindToRenderStep(
    "ALKEDION_AIM",
    Enum.RenderPriority.Camera.Value + 10,
    function()
        Camera = workspace.CurrentCamera
        if not Camera then return end

        UpdateFOV()
        UpdateESP()
        UpdateHitbox()
        ApplyGodMode()
        ApplyRapidFire()
        ApplyAutoReload()
        ApplyNoRecoil()

        if not Aim then
            Target = nil
            TargetText.Text = "Target: None"
            return
        end

        if Lock then
            if not Valid(Target) then Target = Closest() end
        else
            Target = Closest()
        end

        if Target and Valid(Target) then
            local part = GetPart(Target.Character)
            if part then
                local desired = CFrame.lookAt(Camera.CFrame.Position, part.Position)
                local alpha = math.clamp(Smooth/100, .01, 1)
                Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
                TargetText.Text = "Target: " .. Target.DisplayName
            end
        else
            Target = nil
            TargetText.Text = "Target: None"
        end
    end
)

