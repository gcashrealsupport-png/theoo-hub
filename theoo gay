        hum.WalkSpeed = Config.WalkSpeed
        hum.UseJumpPower = true
        hum.JumpPower = Config.JumpPower
    end

    FOVFrame.Size = UDim2.new(0, Config.FOVSize*2, 0, Config.FOVSize*2)
    FOVFrame.Visible = Config.FOV

    if Config.AutoReload and char then
        for _,t in ipairs(char:GetChildren()) do if t:IsA("Tool") then
            for _,v in ipairs(t:GetDescendants()) do
                if v:IsA("NumberValue") and v.Name:lower():find("ammo") then v.Value=9999 end
            end
        end end
    end
    if Config.NoRecoil and char then
        for _,t in ipairs(char:GetChildren()) do if t:IsA("Tool") then
            for _,v in ipairs(t:GetDescendants()) do
                if v:IsA("NumberValue") and v.Name:lower():find("recoil") then v.Value=0 end
            end
        end end
    end
    if Config.NoSpread and char then
        for _,t in ipairs(char:GetChildren()) do if t:IsA("Tool") then
            for _,v in ipairs(t:GetDescendants()) do
                if v:IsA("NumberValue") and v.Name:lower():find("spread") then v.Value=0 end
            end
        end end
    end
    if Config.AntiFling and root then
        for _,v in ipairs(root:GetChildren()) do
            if v:IsA("BodyAngularVelocity") or v:IsA("BodyVelocity") then v:Destroy() end
        end
    end

    for _,v in pairs(TrackLines) do pcall(function() v:Remove() end) end
    TrackLines = {}
    if Config.TrackAll and root then
        local myS = camera:WorldToViewportPoint(root.Position)
        local myV = Vector2.new(myS.X, myS.Y)
        local br = Config.TrackBrightness
        for _,p in ipairs(Players:GetPlayers()) do
            if isEnemy(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local sp = camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                local lin = safeDrawing("Line")
                if lin then
                    lin.From = myV
                    lin.To = Vector2.new(sp.X, sp.Y)
                    lin.Color = Color3.new(br,br,br)
                    lin.Thickness = Config.TrackThickness
                    lin.Visible = true
                    table.insert(TrackLines, lin)
                end
            end
        end
    end

    clearESP()
    if Config.ESP or Config.HealthESP or Config.BoxESP or Config.Tracers or Config.LookLines then
        for _,p in ipairs(Players:GetPlayers()) do
            if isEnemy(p) and p.Character then
                local head = p.Character:FindFirstChild("Head")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if head and h then
                    local sp, on = camera:WorldToViewportPoint(head.Position)
                    if on then
                        if Config.ESP then
                            local l = Instance.new("TextLabel")
                            l.Size = UDim2.new(0,120,0,14)
                            l.Position = UDim2.new(0, sp.X-60, 0, sp.Y-28)
                            l.BackgroundTransparency = 1
                            l.Text = p.DisplayName
                            l.TextColor3 = Color3.new(1,1,1)
                            l.Font = Enum.Font.GothamBold
                            l.TextSize = 12
                            l.Parent = ESPGui
                        end
                        if Config.HealthESP then
                            local l = Instance.new("TextLabel")
                            l.Size = UDim2.new(0,80,0,14)
                            l.Position = UDim2.new(0, sp.X-40, 0, sp.Y-14)
                            l.BackgroundTransparency = 1
                            l.Text = math.floor(h.Health).." HP"
                            l.TextColor3 = Color3.fromRGB(100,255,100)
                            l.Font = Enum.Font.Gotham
                            l.TextSize = 11
                            l.Parent = ESPGui
                        end
                        if Config.BoxESP and hrp then
                            local b = Instance.new("Frame")
                            b.Size = UDim2.new(0,40,0,60)
                            b.Position = UDim2.new(0, sp.X-20, 0, sp.Y-20)
                            b.BackgroundTransparency = 1
                            b.BorderSizePixel = 1
                            b.BorderColor3 = Color3.new(1,1,1)
                            b.Parent = ESPGui
                        end
                    end
                    if Config.Tracers and hrp then
                        local tsp = camera:WorldToViewportPoint(hrp.Position)
                        local lin = safeDrawing("Line")
                        if lin then
                            lin.From = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y)
                            lin.To = Vector2.new(tsp.X, tsp.Y)
                            lin.Color = Color3.new(1,1,1)
                            lin.Thickness = 1
                            lin.Visible = true
                            table.insert(TrackLines, lin)
                        end
                    end
                    if Config.LookLines and hrp then
                        local s1 = camera:WorldToViewportPoint(head.Position)
                        local s2 = camera:WorldToViewportPoint(head.Position + hrp.CFrame.LookVector*6)
                        local lin = safeDrawing("Line")
                        if lin then
                            lin.From = Vector2.new(s1.X, s1.Y)
                            lin.To = Vector2.new(s2.X, s2.Y)
                            lin.Color = Color3.fromRGB(255,200,80)
                            lin.Thickness = 1.5
                            lin.Visible = true
                            table.insert(TrackLines, lin)
                        end
                    end
                end
            end
        end
    end

    if Config.Aimbot and root then
        local center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
        local best, bestD = nil, Config.FOVSize
        for _,p in ipairs(Players:GetPlayers()) do
            if isEnemy(p) and p.Character then
                local part = getAimPart(p)
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if part and h and h.Health>0 and isVisible(part) then
                    local sp, on = camera:WorldToViewportPoint(part.Position)
                    if on and sp.Z>0 then
                        local d = (Vector2.new(sp.X, sp.Y)-center).Magnitude
                        if d<bestD then bestD=d best=part end
                    end
                end
            end
        end
        if best then
            camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, best.Position), Config.Aimsmooth)
            if Config.TargetHighlight then
                local hl = best:FindFirstChild("FatchoiHL")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "FatchoiHL"
                    hl.FillColor = Color3.new(1,1,1)
                    hl.OutlineColor = Color3.new(1,1,1)
                    hl.FillTransparency = 0.7
                    hl.Parent = best
                end
            end
        end
    end

    if Config.Hitbox then
        for _,p in ipairs(Players:GetPlayers()) do
            if isEnemy(p) and p.Character then
                for _,part in ipairs(p.Character:GetChildren()) do
                    if part:IsA("BasePart") and part.Name~="HumanoidRootPart" then
                        part.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                        part.Transparency = 0.5
                        part.CanCollide = false
                    end
                end
            end
        end
    end

    if Config.BigHead then
        local s = Config.BigHeadSize
        for _,p in ipairs(Players:GetPlayers()) do
            if isEnemy(p) and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    head.Size = Vector3.new(s,s,s)
                    head.CanCollide = false
                    head.Massless = true
                end
            end
        end
    end

    if Config.TouchFling and root then
        for _,p in ipairs(Players:GetPlayers()) do
            if isEnemy(p) and p.Character then
                local tr = p.Character:FindFirstChild("HumanoidRootPart")
                if tr and (tr.Position-root.Position).Magnitude<5 then
                    pcall(function()
                        tr.AssemblyLinearVelocity = Vector3.new(0,80,0) + (tr.Position-root.Position).Unit*60
                    end)
                end
            end
        end
    end
end)

player.CharacterAdded:Connect(function(c)
    task.wait(0.5)
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then
        h.WalkSpeed = Config.WalkSpeed
        h.UseJumpPower = true
        h.JumpPower = Config.JumpPower
    end
end)

