local function notify(t, x)
    pcall(function() StarterGui:SetCore("SendNotification", {Title=tostring(t), Text=tostring(x), Duration=2}) end)
end
local function isEnemy(p)
    if not p or p==player then return false end
    if Config.TeamCheck and p.Team and player.Team and p.Team==player.Team then return false end
    return true
end
local function isVisible(part)
    if not Config.VisibleCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {player.Character, part.Parent}
    local hit = workspace:Raycast(camera.CFrame.Position, part.Position-camera.CFrame.Position, params)
    return hit == nil
end
local function getAimPart(p)
    if not p.Character then return nil end
    if Config.AimPart=="Random" then
        local t={}
        for _,v in ipairs(p.Character:GetChildren()) do
            if v:IsA("BasePart") and v.Name~="HumanoidRootPart" then table.insert(t,v) end
        end
        return #t>0 and t[math.random(1,#t)] or nil
    end
    return p.Character:FindFirstChild(Config.AimPart)
end
local function doPanic()
    for k in pairs(Config) do if type(Config[k])=="boolean" then Config[k]=false end end
    for _,v in pairs(TrackLines) do pcall(function() v:Remove() end) end
    TrackLines={}
    notify("Panic","All systems disabled")
end
